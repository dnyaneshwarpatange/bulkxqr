# =============================================================
# BulkXQR Environment Configuration
# Copy this to .env and fill in your values
# =============================================================

# ---- DATABASE ----
DATABASE_URL="postgresql://BulkXQR_user:YOUR_DB_PASSWORD@localhost:5432/BulkXQR_db"

# ---- NEXT AUTH ----
NEXTAUTH_SECRET="your-super-secret-nextauth-key-here"   # openssl rand -base64 32
NEXTAUTH_URL="https://yourdomain.com"

# ---- GOOGLE OAUTH ----
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---- RAZORPAY ----
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ---- EMAIL / SMTP ----
# ============================================================
# OPTION A: Gmail (easiest to start)
# Use an App Password — NOT your real password
# Generate at: https://myaccount.google.com/apppasswords
# ============================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="BulkXQR <your-email@gmail.com>"

# ============================================================
# OPTION B: Your own domain (cPanel / Plesk / DirectAdmin)
# Your hosting control panel gives you SMTP credentials
# ============================================================
# SMTP_HOST="mail.yourdomain.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="noreply@yourdomain.com"
# SMTP_PASS="your-email-password"
# SMTP_FROM="BulkXQR <noreply@yourdomain.com>"

# ============================================================
# OPTION C: Self-hosted Postal (https://postalserver.io)
# Run your own mail server on VPS — full control, free
# ============================================================
# SMTP_HOST="postal.yourdomain.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-postal-user"
# SMTP_PASS="your-postal-api-key"
# SMTP_FROM="BulkXQR <noreply@yourdomain.com>"

# ============================================================
# OPTION D: Local/trusted relay (Postfix on same server)
# No auth needed — server trusts localhost connections
# ============================================================
# SMTP_HOST="localhost"
# SMTP_PORT="25"
# SMTP_SECURE="false"
# SMTP_FROM="BulkXQR <noreply@yourdomain.com>"
# (Leave SMTP_USER and SMTP_PASS blank)

# Allow self-signed TLS certs for self-hosted servers
# SMTP_TLS_REJECT_UNAUTHORIZED="false"

# ---- ADMIN ----
# Comma-separated emails that get admin role on first login
ADMIN_EMAILS="admin@yourdomain.com"

# ---- APP CONFIG ----
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="BulkXQR"
